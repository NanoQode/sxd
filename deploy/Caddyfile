{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Never expose the worker; only the web app is reverse proxied.
	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}

	# Large evidence uploads go straight to object storage via signed URLs, so
	# the app itself only needs a modest request body limit.
	request_body {
		max_size 64MB
	}

	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}
}
