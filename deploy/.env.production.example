# Production environment for deploy/docker-compose.prod.yml.
# Copy to .env.production at the repository root (or set ENV_FILE) and fill in.
# Generate secrets:  openssl rand -base64 48   (AUTH_SECRET)
#                    openssl rand -base64 32   (SECRETS_MASTER_KEY)
#                    openssl rand -hex 24      (passwords)

# --- Public identity --------------------------------------------------------
DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
APP_NAME=SimplexD
APP_URL=https://app.example.com
APP_VERSION=1.0.0
TRUSTED_ORIGINS=
# Internal URL the web process uses to fetch its own redirect-table snapshot for
# the request proxy (docs/workflows/cms.md §5). Defaults to http://127.0.0.1:3000
# inside the container; override only for topologies where that does not resolve.
#INTERNAL_APP_URL=http://127.0.0.1:3000
BUSINESS_TIME_ZONE=Africa/Lagos
LOG_LEVEL=info

# --- Database (used by the compose file to build connection strings) --------
POSTGRES_USER=simplexd_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=simplexd
SIMPLEXD_APP_PASSWORD=change-me
DATABASE_POOL_MAX=10
DATABASE_SSL=disable

# --- Authentication and secrets ---------------------------------------------
AUTH_SECRET=change-me-openssl-rand-base64-48
AUTH_SESSION_MAX_AGE=604800
AUTH_REQUIRE_STAFF_MFA=true
SECRETS_MASTER_KEY=change-me-openssl-rand-base64-32
SECRETS_MASTER_KEY_ID=prod-1
SECRETS_PREVIOUS_MASTER_KEY=
SECRETS_PREVIOUS_MASTER_KEY_ID=

# --- Object storage (S3-compatible; MinIO profile or managed bucket) --------
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET_PRIVATE=simplexd-private
S3_BUCKET_QUARANTINE=simplexd-quarantine
S3_ACCESS_KEY_ID=simplexd
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=simplexd
MINIO_ROOT_PASSWORD=change-me
UPLOAD_MAX_BYTES=2147483648
SIGNED_URL_TTL_SECONDS=300

# --- Upload scanning ----------------------------------------------------------
MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Map tiles (licensed provider; required for the interactive map) ---------
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_STYLE_URL_DARK=
NEXT_PUBLIC_MAP_ATTRIBUTION=
MAP_TILE_HOSTS=

# --- Providers (may also be configured in Admin -> Integrations) -------------
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
TERMII_API_KEY=
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_SENDER_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ALLOWED_HOSTS=
MAIL_FROM_NAME=SimplexD
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_REPLY_TO=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_MEDIA_HOSTNAMES=

# --- Observability ------------------------------------------------------------
SENTRY_DSN=
HEALTH_TOKEN=change-me

# --- Never enable in production -------------------------------------------------
ENABLE_DEMO_SEED=false

# --- Backups (ops/backup/backup.sh) ------------------------------------------------
BACKUP_DIR=/var/backups/simplexd
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_RECIPIENT=
BACKUP_S3_URI=

# --- Optional tuning (defaults shown) ----------------------------------------------
#LOG_PRETTY=false
#WORKER_QUEUES=default,notifications,payments,calendar,media,maintenance
#WORKER_CONCURRENCY=4
#WORKER_POLL_MS=1000
#OUTBOX_POLL_MS=750
#WORKER_HEALTH_PORT=3100
#TERMII_ALLOWED_HOSTS=v3.api.termii.com
