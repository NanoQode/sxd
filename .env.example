# SimplexD environment example. Copy to .env for local development.
# Never commit real secrets. Production values belong in the host's secret store.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | test | staging | production (NODE_ENV is set by the tooling; do not put it here)
APP_ENV=development
APP_NAME=SimplexD
# Public origin of the web app (no trailing slash). Used for absolute links,
# OAuth redirect URIs, webhook URLs, cookies and CSP.
APP_URL=http://localhost:3000
# Comma-separated additional origins allowed to call the browser API (CORS).
TRUSTED_ORIGINS=
PORT=3000
# Where the request proxy reaches this same deployment for its redirect-table
# snapshot (docs/workflows/cms.md §5). Defaults to http://127.0.0.1:$PORT; set it
# only when the web process cannot reach itself on the loopback interface.
#INTERNAL_APP_URL=http://127.0.0.1:3000
LOG_LEVEL=info
# Time zone used for business-facing displays (customers may choose their own).
BUSINESS_TIME_ZONE=Africa/Lagos

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16 + PostGIS)
# ---------------------------------------------------------------------------
# Runtime role: non-superuser, cannot bypass row-level security.
DATABASE_URL=postgres://simplexd_app:simplexd_app_local@127.0.0.1:5432/simplexd_dev
# Owner role used only for migrations, seeding and bootstrap commands.
MIGRATION_DATABASE_URL=postgres://simplexd_owner:simplexd_owner_local@127.0.0.1:5432/simplexd_dev
DATABASE_POOL_MAX=10
# Set to "require" behind managed databases that enforce TLS.
DATABASE_SSL=disable

# ---------------------------------------------------------------------------
# Redis (rate limits, caches, coordination locks)
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# 32+ random bytes, base64 or hex. Generate: openssl rand -base64 48
AUTH_SECRET=replace-me-with-openssl-rand-base64-48
# Session lifetime in seconds (default 7 days) and idle refresh window.
AUTH_SESSION_MAX_AGE=604800
# Require MFA for staff roles holding finance/access/data-publication/integration permissions.
AUTH_REQUIRE_STAFF_MFA=true

# ---------------------------------------------------------------------------
# Secrets at rest (integration credentials, OAuth refresh tokens)
# ---------------------------------------------------------------------------
# Master key for envelope encryption (AES-256-GCM). 32 bytes, base64.
# Generate: openssl rand -base64 32
SECRETS_MASTER_KEY=replace-me-with-openssl-rand-base64-32
# Key identifier recorded on every ciphertext so keys can be rotated.
SECRETS_MASTER_KEY_ID=local-1
# Optional previous key for rotation windows (same format). Leave empty otherwise.
SECRETS_PREVIOUS_MASTER_KEY=
SECRETS_PREVIOUS_MASTER_KEY_ID=

# ---------------------------------------------------------------------------
# Object storage (private S3-compatible bucket)
# ---------------------------------------------------------------------------
# s3 | local-dev (development only; stores files under ./uploads-dev)
STORAGE_PROVIDER=local-dev
# Development-only file store shared by web and worker. Defaults to var/uploads-dev at the
# workspace root; set an absolute path to move it. Never used when STORAGE_PROVIDER=s3.
# DEV_STORAGE_ROOT=
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET_PRIVATE=simplexd-private
S3_BUCKET_QUARANTINE=simplexd-quarantine
S3_ACCESS_KEY_ID=simplexd
S3_SECRET_ACCESS_KEY=simplexd_minio_local
S3_FORCE_PATH_STYLE=true
# Maximum upload size in bytes (default 2 GiB; large media uses multipart uploads).
UPLOAD_MAX_BYTES=2147483648
SIGNED_URL_TTL_SECONDS=300

# Malware scanning: clamav (clamd INSTREAM over TCP) | dev (labelled development scanner)
MALWARE_SCANNER=dev
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ---------------------------------------------------------------------------
# Map tiles (MapLibre GL JS). A licensed provider style URL with its key.
# Public community tile servers must not be used as a production backend.
# ---------------------------------------------------------------------------
# Example (MapTiler): https://api.maptiler.com/maps/streets-v2/style.json?key=KEY
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_STYLE_URL_DARK=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Comma-separated hostnames that the CSP allows for tiles/styles/sprites/fonts.
MAP_TILE_HOSTS=

# ---------------------------------------------------------------------------
# Provider adapters. In development/test the labelled "dev" adapters are used
# when a provider is not configured. Production refuses dev adapters.
# Credentials for Paystack, Termii, SMTP and Google are configured in
# Admin -> Integrations and stored encrypted; the environment variables below
# are optional bootstrap values for automated deployments.
# ---------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_PATH=/api/v1/webhooks/paystack

TERMII_API_KEY=
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_SENDER_ID=

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# implicit-tls | starttls | none (none is allowed in development only)
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_NAME=SimplexD
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_REPLY_TO=
# Comma-separated SMTP hosts permitted for outbound connections (SSRF allow-list).
SMTP_ALLOWED_HOSTS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI shown to admins; must match the Google Cloud OAuth client exactly.
GOOGLE_OAUTH_REDIRECT_PATH=/api/v1/admin/integrations/google/callback

# ---------------------------------------------------------------------------
# Public media hostnames allowed for next/image (comma separated, https only).
# ---------------------------------------------------------------------------
PUBLIC_MEDIA_HOSTNAMES=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=
# Health endpoint token for uptime monitors that need queue depth details.
HEALTH_TOKEN=

# ---------------------------------------------------------------------------
# Demo seeding is refused unless APP_ENV is development or test.
# The first administrator is created with `pnpm db:bootstrap-admin`, which
# prints a one-time setup link; there is no hardcoded admin password.
# ---------------------------------------------------------------------------
ENABLE_DEMO_SEED=true

# ---------------------------------------------------------------------------
# Optional tuning (defaults shown). LOG_PRETTY=true prints human-readable logs;
# APP_VERSION is stamped on health checks and error reports.
# ---------------------------------------------------------------------------
#APP_VERSION=dev
#LOG_PRETTY=false
#WORKER_QUEUES=default,notifications,payments,calendar,media,maintenance
#WORKER_CONCURRENCY=4
#WORKER_POLL_MS=1000
#OUTBOX_POLL_MS=750
#WORKER_HEALTH_PORT=3100
# Comma-separated Termii API hosts permitted for outbound connections (SSRF allow-list).
#TERMII_ALLOWED_HOSTS=v3.api.termii.com
# Signs development-storage download links; defaults to AUTH_SECRET.
#DEV_STORAGE_SIGNING_SECRET=
