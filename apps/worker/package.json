{
  "name": "@simplexd/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Background worker: outbox relay, durable job queue consumers, notification delivery, payment reconciliation, calendar sync, media processing and scheduled maintenance.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "seed:templates": "tsx --env-file-if-exists=../../.env src/cli/seed-templates.ts"
  },
  "dependencies": {
    "@simplexd/contracts": "workspace:*",
    "@simplexd/db": "workspace:*",
    "@simplexd/domain": "workspace:*",
    "@simplexd/finance": "workspace:*",
    "@simplexd/integrations": "workspace:*",
    "@simplexd/notifications": "workspace:*",
    "drizzle-orm": "0.45.3",
    "ioredis": "6.0.0",
    "luxon": "3.7.2",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/luxon": "3.7.5",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
