{
  "name": "@simplexd/integrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider interfaces and adapters: payments (Paystack), SMS (Termii), mail (SMTP), Google Calendar/Meet, object storage (S3), malware scanning, map tiles, plus labeled development adapters and secret envelope encryption.",
  "exports": {
    ".": "./src/index.ts",
    "./payments": "./src/payments/index.ts",
    "./sms": "./src/sms/index.ts",
    "./mail": "./src/mail/index.ts",
    "./google": "./src/google/index.ts",
    "./storage": "./src/storage/index.ts",
    "./scanner": "./src/scanner/index.ts",
    "./maps": "./src/maps/index.ts",
    "./secrets": "./src/secrets/index.ts",
    "./net": "./src/net/index.ts",
    "./config": "./src/config/index.ts",
    "./templates": "./src/templates/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "@aws-sdk/s3-request-presigner": "3.1138.0",
    "@simplexd/contracts": "workspace:*",
    "@simplexd/db": "workspace:*",
    "@simplexd/domain": "workspace:*",
    "drizzle-orm": "0.45.3",
    "file-type": "22.1.1",
    "googleapis": "181.0.0",
    "ics": "3.12.0",
    "ioredis": "6.0.0",
    "libphonenumber-js": "1.13.13",
    "luxon": "3.7.2",
    "nodemailer": "10.0.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/luxon": "3.7.5",
    "@types/nodemailer": "8.0.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
